{
  "name": "@codex-app-sdk/basic-web-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "check": "npm run lint && npm run build",
    "dev": "node scripts/dev.mjs",
    "lint": "npm run typecheck",
    "start": "npm run build && node dist/server/index.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@codex-app-sdk/backend": "0.14.4",
    "@codex-app-sdk/core": "0.14.4",
    "@codex-app-sdk/vue": "0.14.4",
    "@codex-app-sdk/web": "0.14.4",
    "express": "^5.1.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.0"
  }
}
