{
  "name": "@codex-app-sdk/web",
  "version": "0.14.0",
  "description": "Framework-neutral WebSocket bindings for browser-based Codex applications.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codex-app-sdk/codex-app-sdk.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "check": "npm run lint && npm run test:coverage && npm run build",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "cd ../.. && stryker run packages/web/stryker.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-app-sdk/core": "0.14.0"
  },
  "engines": {
    "node": ">=22"
  }
}
