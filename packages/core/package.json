{
  "name": "@codex-app-sdk/core",
  "version": "0.1.0",
  "description": "Renderer-safe contracts and shared primitives for Codex applications.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/typed-event-bus.d.ts",
      "import": "./dist/events.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    },
    "./surface-bridge": {
      "types": "./dist/surface-bridge.d.ts",
      "import": "./dist/surface-bridge.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "check": "npm run lint && npm test && npm run build",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  }
}
