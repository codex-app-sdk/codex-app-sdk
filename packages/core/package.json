{
  "name": "@codex-app-sdk/core",
  "version": "0.15.1",
  "description": "Renderer-safe contracts and shared primitives for Codex applications.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codex-app-sdk/codex-app-sdk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/typed-event-bus.d.ts",
      "import": "./dist/events.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    },
    "./surface-bridge": {
      "types": "./dist/surface-bridge.d.ts",
      "import": "./dist/surface-bridge.js"
    },
    "./conversation-replica": {
      "types": "./dist/conversation-replica.d.ts",
      "import": "./dist/conversation-replica.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "check": "npm run lint && npm run test:coverage && npm run build",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "cd ../.. && stryker run packages/core/stryker.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  }
}
