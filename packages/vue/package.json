{
  "name": "@codex-app-sdk/vue",
  "version": "0.14.4",
  "description": "Vue conversation components and composables for Codex applications.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codex-app-sdk/codex-app-sdk.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly && node ../../scripts/package-katex-assets.mjs dist/styles.css dist/fonts && node ../../scripts/verify-package-css.mjs dist/styles.css dist/index.d.ts dist/fonts",
    "check": "npm run lint && npm run test:coverage && npm run build",
    "lint": "vue-tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "cd ../.. && stryker run packages/vue/stryker.config.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-app-sdk/core": "0.14.4",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@tabler/icons-vue": "^3.44.0",
    "beautiful-mermaid": "^1.1.3",
    "fix-webm-duration": "^1.0.6",
    "katex": "^0.17.0",
    "marked": "^17.0.6",
    "marked-katex-extension": "^5.1.10",
    "shiki": "^4.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
