{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": false,
    "outDir": "dist/server",
    "rootDir": "src/server",
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts"]
}
