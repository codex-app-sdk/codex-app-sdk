{
  "name": "@codex-app-sdk/create-codex-app",
  "version": "0.12.4",
  "description": "Scaffold Electron or web Vue applications powered by Codex App SDK.",
  "type": "module",
  "main": "./src/cli.js",
  "exports": {
    ".": "./src/cli.js"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codex-app-sdk/codex-app-sdk.git",
    "directory": "packages/create-codex-app"
  },
  "homepage": "https://nbonamy.github.io/codex-app-sdk/guide/scaffolding",
  "bin": {
    "create-codex-app": "./bin/create-codex-app.js"
  },
  "files": [
    "bin",
    "src",
    "template",
    "template-web"
  ],
  "scripts": {
    "check": "npm run lint && npm test",
    "lint": "node --check bin/create-codex-app.js && node --check src/cli.js && node --check tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
