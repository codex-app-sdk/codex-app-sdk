{
  "name": "@codex-app-sdk/electron",
  "version": "0.13.0",
  "description": "Electron main, preload, IPC, and native capability adapter for Codex applications.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codex-app-sdk/codex-app-sdk.git",
    "directory": "packages/electron"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "check": "npm run lint && npm run test:coverage && npm run build",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "cd ../.. && stryker run packages/electron/stryker.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-app-sdk/backend": "0.13.0",
    "@codex-app-sdk/core": "0.13.0"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "engines": {
    "node": ">=22"
  }
}
