{
  "name": "codex-app-sdk",
  "version": "0.1.0",
  "description": "High-level runtime, Electron bridge, and Vue kit for building Codex surfaces.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbonamy/codex-app-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nbonamy/codex-app-sdk/issues"
  },
  "homepage": "https://nbonamy.github.io/codex-app-sdk/",
  "workspaces": [
    "samples/*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "assets",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron.js"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload.d.ts",
      "import": "./dist/electron-preload.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node.js"
    },
    "./surface": {
      "types": "./dist/surface/index.d.ts",
      "import": "./dist/surface.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./styles.css": "./dist/codex-app-sdk.css"
  },
  "scripts": {
    "schema:generate": "node scripts/generate-codex-schema.mjs",
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly && node scripts/verify-package-css.mjs && node scripts/verify-native-assets.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs --port 5175",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4175",
    "sample:build": "npm run build -w @codex-app-sdk/basic-sample",
    "sample:start": "npm run start -w @codex-app-sdk/basic-sample",
    "sample:test": "npm run test -w @codex-app-sdk/basic-sample",
    "spark:build": "npm run build -w @codex-app-sdk/spark-sample",
    "spark:dev": "npm run dev -w @codex-app-sdk/spark-sample",
    "spark:start": "npm run start -w @codex-app-sdk/spark-sample",
    "spark:test": "npm run test -w @codex-app-sdk/spark-sample",
    "spark:typecheck": "npm run typecheck -w @codex-app-sdk/spark-sample",
    "relay:build": "npm run build -w @codex-app-sdk/relay-sample",
    "relay:dev": "npm run dev -w @codex-app-sdk/relay-sample",
    "relay:start": "npm run start -w @codex-app-sdk/relay-sample",
    "relay:test": "npm run test -w @codex-app-sdk/relay-sample",
    "relay:typecheck": "npm run typecheck -w @codex-app-sdk/relay-sample",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@tabler/icons-vue": "^3.44.0",
    "beautiful-mermaid": "^1.1.3",
    "fix-webm-duration": "^1.0.6",
    "marked": "^17.0.6",
    "shiki": "^4.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
